# 服务端口
KOA_PORT=8001

# MySQL 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wudong

# JWT 签名密钥（生产环境必须改为随机长字符串）
JWT_SECRET=

# ===== 阿里云 OSS 图片存储（公共读 bucket）=====
# 填写后后台文件上传（admin/base/comm/upload）改为写入 OSS；留空则回退本地 public/upload
# 地域，如 oss-cn-guizhou
OSS_REGION=
# bucket 名称
OSS_BUCKET=
# 访问密钥（建议使用仅有该 bucket 读写权限的 RAM 子账号）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：访问域名，留空则用 oss-{OSS_REGION}.aliyuncs.com
OSS_ENDPOINT=
# 可选：CDN / 自定义域名（如 https://img.example.com），留空则用 https://{bucket}.{endpoint}
OSS_PUBLIC_BASE_URL=
# 可选：对象键前缀，默认 wudong
OSS_PREFIX=wudong
# 可选：STS 临时授权 token，一般留空
OSS_STS_TOKEN=
