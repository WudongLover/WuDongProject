{
  "name": "wu-dong-midway",
  "version": "0.1.0",
  "description": "乌东文旅后端服务（纯 Midway v3 + TypeORM + MySQL，业务模块：entity / mapper / service / controller）",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=local mwtsc --cleanOutDir --watch --run @midwayjs/mock/app.js --keepalive",
    "start": "cross-env NODE_ENV=production node ./bootstrap.js",
    "build": "mwtsc --cleanOutDir",
    "lint": "mwts check",
    "lint:fix": "mwts fix"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@langchain/core": "^1.2.10",
    "@langchain/openai": "^1.5.12",
    "@langchain/textsplitters": "^1.0.1",
    "@midwayjs/bootstrap": "^3.20.3",
    "@midwayjs/core": "^3.20.3",
    "@midwayjs/koa": "^3.20.3",
    "@midwayjs/logger": "^3.4.2",
    "@midwayjs/typeorm": "^3.20.3",
    "@midwayjs/upload": "^3.20.24",
    "@midwayjs/validate": "^3.20.24",
    "ali-oss": "^6.23.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "mysql2": "^3.14.0",
    "typeorm": "0.3.20"
  },
  "devDependencies": {
    "@midwayjs/mock": "^3.20.3",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^22",
    "mwts": "^1.3.0",
    "mwtsc": "^1.15.1",
    "typescript": "~5.8.2"
  }
}
