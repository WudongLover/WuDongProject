# 复制为 .env 后按需修改（.env 已 gitignore）

# 服务端口
KOA_PORT=6666

# MySQL 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wudong

# JWT 签名密钥：access token 签名与 refresh token 哈希共用
# 缺省回落到内置开发密钥，生产环境必须显式配置
JWT_SECRET=
# ===== m6-agent 智能体配置（留空则智能体接口返回未启用提示） =====
# LLM API 地址（OpenAI 兼容协议，如 DeepSeek 填 https://api.deepseek.com/v1）
LLM_BASE_URL=
# LLM API Key
LLM_API_KEY=
# 模型名称（如 deepseek-chat / qwen-plus / gpt-4o-mini）
LLM_MODEL_NAME=
# Embedding 模型（RAG 向量化用，可与主 LLM 不同厂商）
# 以下三项留空则复用主 LLM 的 API_KEY / BASE_URL
LLM_EMBEDDING_MODEL=text-embedding-v1
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_URL=
