# 复制为 .env 后按需修改（.env 已 gitignore）

# 服务端口
KOA_PORT=6666

# MySQL 数据库
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_DATABASE=wudong

# 演示身份兜底：请求头 x-user-id 缺省时使用的 user_id
# 订单 / 购物车 / 社区共用；需与 wudong_common_user 中已存在的用户对应
DEMO_USER_ID=1

# JWT 签名密钥：access token 签名与 refresh token 哈希共用
# 缺省回落到内置开发密钥，生产环境必须显式配置
JWT_SECRET=
