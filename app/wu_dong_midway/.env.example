# 复制为 .env 后按需修改（.env 已 gitignore）
KOA_PORT=8001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=123321
MYSQL_DATABASE=wudong

# ===== Redis 首页缓存（留空则自动关闭并直接查询数据库） =====
# 推荐使用 REDIS_URL；也可拆分配置 REDIS_HOST / REDIS_PORT 等
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
# 首页文化推文缓存时间（秒）
REDIS_CACHE_TTL=300

# ===== m6-agent 智能体配置（留空则智能体接口返回未启用提示） =====
# LLM API 地址（OpenAI 兼容协议，如 DeepSeek 填 https://api.deepseek.com/v1）
LLM_BASE_URL=
# LLM API Key
LLM_API_KEY=
# 模型名称（如 deepseek-chat / qwen-plus / gpt-4o-mini）
LLM_MODEL_NAME=
# Embedding 模型（RAG 向量化用，可与主 LLM 不同厂商）
# 以下三项留空则复用主 LLM 的 API_KEY / BASE_URL
LLM_EMBEDDING_MODEL=text-embedding-v1
LLM_EMBEDDING_API_KEY=
LLM_EMBEDDING_URL=

# ===== 阿里云 OSS 图片存储（公共读 bucket）=====
# 填写后 POST /api/upload 与图片迁移脚本生效；留空则上传接口返回“未配置”业务错误
# 地域，如 oss-cn-guizhou
OSS_REGION=
# bucket 名称
OSS_BUCKET=
# 访问密钥（建议使用仅有该 bucket 读写权限的 RAM 子账号）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 可选：访问域名，留空则用 oss-{OSS_REGION}.aliyuncs.com
OSS_ENDPOINT=
# 可选：CDN / 自定义域名（如 https://img.example.com），留空则用 https://{bucket}.{endpoint}
OSS_PUBLIC_BASE_URL=
# 可选：对象键前缀，默认 wudong
OSS_PREFIX=wudong
# 可选：STS 临时授权 token，一般留空
OSS_STS_TOKEN=
